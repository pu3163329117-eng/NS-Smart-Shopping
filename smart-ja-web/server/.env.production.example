# Copy this file to server/.env.production for non-docker server runtime.
# Do not commit real secrets.

PORT=3005
JWT_SECRET=change_this_to_a_long_random_secret
NODE_ENV=production
TRUST_PROXY=1
BODY_LIMIT=1mb
LOG_FORMAT=combined
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production
DEEPSEEK_API_KEY=
AI_REQUIRE_PAYMENT_CONFIRM=true

DATABASE_URL=postgresql://postgres:change_this_db_password@127.0.0.1:5432/smart_ja_db
UPLOAD_DIR=uploads
CORS_ALLOW_ORIGINS=https://app.example.com

# Object storage (optional)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=smart-ja-uploads
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
CDN_DOMAIN=
