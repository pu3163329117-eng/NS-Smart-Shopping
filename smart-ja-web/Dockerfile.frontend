## Stage 1: Build (only used when building locally; CI pre-builds dist/ via npm run build)
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Override at build time if backend is hosted elsewhere:
# docker build --build-arg VITE_API_URL=https://api.example.com/api ...\
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
ARG VITE_API_TIMEOUT_MS=60000
ENV VITE_API_TIMEOUT_MS=${VITE_API_TIMEOUT_MS}
ARG VITE_CLIENT_TELEMETRY=true
ENV VITE_CLIENT_TELEMETRY=${VITE_CLIENT_TELEMETRY}
ARG VITE_SENTRY_DSN=
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
ARG VITE_SENTRY_SAMPLE_RATE=0
ENV VITE_SENTRY_SAMPLE_RATE=${VITE_SENTRY_SAMPLE_RATE}

RUN npm run build

## Stage 2: Serve via Nginx
FROM nginx:1.27-alpine AS runtime

# Base config (HTTP only, for Docker-internal use)
# In production, docker-compose mounts nginx/app.conf (SSL version) over this file
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
