# ============================================================
# NS Matrix (Smart JA) 生产环境配置模板
# 使用方法:
#   cp .env.production.example .env.production
#   # 填入真实值后执行：
#   docker compose --env-file .env.production -f docker-compose.fullstack.yml up -d --build
# ============================================================

# ----------------------------
# 🌐 网络与端口
# ----------------------------
FRONTEND_PORT=80          # 对外暴露的前端端口（Nginx），正式域名用 80/443
NODE_ENV=production

# ----------------------------
# 🗄️ 数据库 PostgreSQL
# ----------------------------
POSTGRES_USER=smartja_prod
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD_32CHARS
POSTGRES_DB=smart_ja_prod

# ----------------------------
# 🔑 JWT & 安全
# ----------------------------
# 必须改！推荐使用: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_MIN_32_CHARS

# ----------------------------
# 🤖 AI 服务 API Keys
# ----------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here
AI_REQUIRE_PAYMENT_CONFIRM=true

# ----------------------------
# 🛡️ 跨域白名单（必须配置！）
# ----------------------------
# 逗号分隔的允许来源，必须包含 https:// 前缀
CORS_ALLOW_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ----------------------------
# 🪣 对象存储 (S3/MinIO)
# ----------------------------
# 方案 A: 使用云上 S3（推荐生产使用）
# S3_REGION=ap-east-1
# S3_ACCESS_KEY_ID=your-aws-access-key
# S3_SECRET_ACCESS_KEY=your-aws-secret-key
# S3_BUCKET=smart-ja-uploads
# S3_ENDPOINT=          # AWS S3 留空，自建 MinIO 填写端点
# S3_FORCE_PATH_STYLE=false
# CDN_DOMAIN=https://cdn.your-domain.com

# 方案 B: 使用自建 MinIO（随 Docker Compose 部署）
# 参考 docker-compose.minio.yml 配置
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_MINIO_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_MINIO_SECRET_KEY_MIN_8_CHARS
S3_BUCKET=smart-ja-uploads
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
CDN_DOMAIN=https://your-domain.com/uploads   # 或 MinIO/CDN 公网地址

# ----------------------------
# 👑 管理员配置
# ----------------------------
# 逗号分隔的管理员用户 ID（在数据库用户表中查看）
GUSHI_ADMIN_IDS=user-id-1,user-id-2
# 逗号分隔的管理员邮箱
GUSHI_ADMIN_EMAILS=admin@your-domain.com

# ----------------------------
# 🚀 功能开关
# ----------------------------
ENABLE_SWAGGER=false                  # 生产环境必须关闭 API 文档
ENABLE_WALLET_TOPUP=false             # 钱包充值（接入真实支付后开启）
ENABLE_BOOTSTRAP_SEED=false           # 数据库初始化种子数据（首次部署后关闭）
ENABLE_LEGACY_MIGRATION=false         # 老数据迁移（迁移完成后关闭）
ALLOW_DEV_ADMIN_BYPASS=false          # 开发用管理员旁路（生产必须 false！）
INVESTOR_DASHBOARD_PUBLIC=false       # 投资人面板是否公开访问
EXPOSE_DEBUG_SMS_CODE=false           # 响应里是否暴露验证码（生产必须 false！）

# ----------------------------
# 📝 上传目录（本地 fallback）
# ----------------------------
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=https://your-domain.com   # 上传文件的基础 URL（本地 fallback 时用）

# ----------------------------
# 🔴 Redis 缓存
# ----------------------------
REDIS_URL=redis://redis:6379              # Docker 内部服务名

# ----------------------------
# 📊 监控（可选）
# ----------------------------
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Runtime hardening
TRUST_PROXY=1
BODY_LIMIT=1mb
LOG_FORMAT=combined
# Frontend observability
VITE_CLIENT_TELEMETRY=true
VITE_SENTRY_DSN=
VITE_SENTRY_SAMPLE_RATE=0

# Backend Sentry tuning
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production
