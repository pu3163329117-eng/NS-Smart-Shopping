# Copy this file to .env.fullstack and fill real values before production deploy.
# Usage:
# docker compose --env-file .env.fullstack -f docker-compose.fullstack.yml up -d --build

# Frontend
FRONTEND_PORT=8080

# Database (used by db + backend services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_db_password
POSTGRES_DB=smart_ja_db

# Backend secrets
JWT_SECRET=change_this_to_a_long_random_secret
DEEPSEEK_API_KEY=
ENABLE_SWAGGER=false
ENABLE_WALLET_TOPUP=false
ENABLE_BOOTSTRAP_SEED=false
ENABLE_LEGACY_MIGRATION=false
ALLOW_DEV_ADMIN_BYPASS=false
INVESTOR_DASHBOARD_PUBLIC=false
EXPOSE_DEBUG_SMS_CODE=false
GUSHI_ADMIN_IDS=
GUSHI_ADMIN_EMAILS=admin@example.com
CORS_ALLOW_ORIGINS=https://app.example.com

# Object storage (optional; keep empty if not used)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=smart-ja-uploads
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
CDN_DOMAIN=
